# Secrets — never commit
.env

# TLS private keys and certificates (dir is auto-created by Docker on `up`)
nginx/certs/

# Model weights — downloaded to MODEL_PATH (default /data/models), never vendored
*.safetensors
*.bin
*.gguf
models/

# Generated docs — markdown + SVG are canonical; don't commit rendered PDFs
*.pdf

# Benchmark artifacts — run outputs and sweep.py's compose backup
bench/res_*.json
bench/*.log
bench/docker-compose.yml.orig

# Python / OS cruft
__pycache__/
*.pyc
.DS_Store

# Local backups of edited files (e.g. docker-compose.yml.bak.*)
*.bak
*.bak.*
