# ─────────────────────────────────────────────────────────────────────────────
#  Nginx front door for the stack.
#
#  This is a TEMPLATE. The stock nginx image runs envsubst over it at startup,
#  replacing ${LLM_API_KEY} with the value from .env and writing the result to
#  /etc/nginx/conf.d/default.conf. Only variables that exist in the container's
#  environment are substituted, so nginx's own $variables are left alone.
#
#  Routes:
#    /coding/v1/messages  → anthropic-shim → vLLM   (Anthropic API, Claude Code)
#    /coding/*            → vLLM                    (OpenAI API, everything else)
#    /health, /           → answered by nginx, no key needed
# ─────────────────────────────────────────────────────────────────────────────

# ─── API key check ────────────────────────────────────────────────
# Accept the key in either header, because clients differ:
#   Authorization: Bearer <key>  — OpenAI SDKs, Continue, Cursor, curl, and Claude Code
#                                  with ANTHROPIC_AUTH_TOKEN (what the README uses)
#   x-api-key: <key>             — Anthropic SDKs, and Claude Code with ANTHROPIC_API_KEY
# docker-compose.yml refuses to start if LLM_API_KEY is empty, so an empty key
# can never match a request that simply omits both headers.
#
# Anchored regexes ("~", case-sensitive) rather than plain strings: nginx matches
# plain map strings case-insensitively, which would accept the key in any case.
# The key is pasted into the regex, which is why .env.example asks for letters
# and digits only.
map $http_authorization $bearer_ok {
    "~^Bearer ${LLM_API_KEY}$"  1;
    default                     0;
}
map $http_x_api_key $x_api_key_ok {
    "~^${LLM_API_KEY}$"  1;
    default              0;
}
map "$bearer_ok:$x_api_key_ok" $api_key_ok {
    "0:0"    0;
    default  1;
}

# ─── Upstream resolution ──────────────────────────────────────────
# Resolve the upstream containers through Docker's embedded DNS on every request
# (cached 10s) instead of once at startup. With a static `upstream` block nginx
# keeps the IP it saw at boot, so recreating vllm-coding (bench/sweep.py does
# this) could leave nginx proxying to a dead address until it was restarted.
resolver 127.0.0.11 valid=10s ipv6=off;

# ─── Shared proxy settings ────────────────────────────────────────
proxy_http_version      1.1;
proxy_set_header        Host              $host;
proxy_set_header        X-Real-IP         $remote_addr;
proxy_set_header        X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header        Connection        "";     # responses are SSE over plain HTTP/1.1; no upgrades
proxy_read_timeout      600s;                     # per read, not per request — see IMPLEMENTATION_GUIDE.md
proxy_send_timeout      600s;
client_max_body_size    50M;

server {
    listen 80;
    server_name _;

    set $vllm_upstream  http://vllm-coding:8000;
    set $shim_upstream  http://anthropic-shim:8080;

    # Anthropic /v1/messages (and /v1/messages/count_tokens) → normalizing shim.
    # A longer prefix than /coding/, so it wins for these paths.
    location /coding/v1/messages {
        if ($api_key_ok = 0) { return 401 "missing or wrong API key\n"; }
        rewrite ^/coding(/.*)$ $1 break;
        proxy_pass $shim_upstream;
        proxy_buffering off;          # stream SSE tokens through immediately
    }

    # Everything else under /coding/ → vLLM directly (OpenAI API, /v1/models, ...).
    location /coding/ {
        if ($api_key_ok = 0) { return 401 "missing or wrong API key\n"; }
        rewrite ^/coding(/.*)$ $1 break;
        proxy_pass $vllm_upstream;
        proxy_buffering off;
    }

    location /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        default_type text/plain;
        return 200 "DGX LLM API\nEndpoint: /coding/v1/ (API key required)\n";
    }
}

