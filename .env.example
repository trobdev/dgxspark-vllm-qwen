# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — never commit it.

# Required. API key that nginx checks on every /coding/ request. Clients send it as
# `Authorization: Bearer <key>` (OpenAI SDKs, Continue, Claude Code via
# ANTHROPIC_AUTH_TOKEN) or `x-api-key: <key>` (Anthropic SDKs).
# Generate one with:  openssl rand -hex 32
# Use letters and digits only — the value is substituted into nginx's config.
LLM_API_KEY=

# Host directory where model weights are stored and bind-mounted into the container.
# Must exist before `docker compose up` (see README → First-time setup).
MODEL_PATH=/data/models

# Optional. Only needed if you download gated models. The two models this stack
# uses are public (Apache-2.0), so you can leave this empty.
HF_TOKEN=
